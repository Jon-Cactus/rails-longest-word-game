<h1 class="display-1 text-center">New Game</h1>
<div class="container d-flex gap-2 justify-content-between my-3">
  <% @letters.each do |letter| %>
    <div class="bg-info p-5 rounded shadow border">
      <h2 class="text-white"><%=letter%></h2>
    </div>
  <% end %>
</div>
<div class="form-group w-25 d-flex mx-auto">
  <form action="/score" method="post" data-turbo="false">
    <label for="answer">What's your best word?</label>
    <input type="text" id="answer" name="answer" class="form-control my-2">
    <%= hidden_field_tag "letters", @letters %>
    <input type="submit" value="See score" class="btn btn-primary">
    <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
  </form>
</div>
